<?xml version="1.0" ?>
<!--
  WORLD: Đường thẳng 100m x 8m với vật cản
  - START: x=0, y=0 (marker xanh lá)
  - GOAL: x=100, y=0 (marker đỏ)
  - 10 vật cản (box/cylinder) rải rác trên đường
  
  DANH SÁCH VẬT CẢN:
  ┌─────────────┬──────────┬───────────────────┬─────────────────┐
  │ Tên         │ Loại     │ Kích thước        │ Tọa độ (x,y,z)  │
  ├─────────────┼──────────┼───────────────────┼─────────────────┤
  │ obstacle_01 │ Box      │ 1.2 x 1.2 x 1.2   │ (15, 0, 0.6)    │
  │ obstacle_02 │ Cylinder │ r=0.7, h=1.2      │ (25, 1.5, 0.6)  │
  │ obstacle_03 │ Box      │ 1.4 x 1.4 x 1.2   │ (35, -1.2, 0.6) │
  │ obstacle_04 │ Cylinder │ r=0.6, h=1.2      │ (45, 0.8, 0.6)  │
  │ obstacle_05 │ Box      │ 1.3 x 1.3 x 1.2   │ (55, -0.5, 0.6) │
  │ obstacle_06 │ Cylinder │ r=0.8, h=1.2      │ (65, 1.8, 0.6)  │
  │ obstacle_07 │ Box      │ 1.2 x 1.2 x 1.2   │ (75, -1.5, 0.6) │
  │ obstacle_08 │ Cylinder │ r=0.65, h=1.2     │ (85, 0.3, 0.6)  │
  │ obstacle_09 │ Box      │ 1.4 x 1.4 x 1.2   │ (92, -1.0, 0.6) │
  │ obstacle_10 │ Cylinder │ r=0.7, h=1.2      │ (98, 1.2, 0.6)  │
  └─────────────┴──────────┴───────────────────┴─────────────────┘
-->
<sdf version="1.8">
  <world name="straight_road_world">
    
    <!-- ============== PLUGINS HỆ THỐNG ============== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    
    <!-- ============== VẬT LÝ ============== -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    
    <!-- ============== ÁNH SÁNG ============== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>
    
    <light type="directional" name="sun2">
      <cast_shadows>false</cast_shadows>
      <pose>50 0 30 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 -0.5 -1</direction>
    </light>
    
    <!-- ============== MẶT ĐẤT (100m x 8m) ============== -->
    <model name="ground_plane">
      <static>true</static>
      <pose>50 0 0 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>110 10 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box>
              <size>110 10 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============== ĐƯỜNG (visual) ============== -->
    <model name="road_surface">
      <static>true</static>
      <pose>50 0 0.051 0 0 0</pose>
      <link name="road_link">
        <visual name="road_visual">
          <geometry>
            <box>
              <size>100 8 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============== MARKER START (xanh lá) ============== -->
    <model name="start_marker">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry>
            <box>
              <size>2 4 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.2 1</ambient>
            <diffuse>0.2 0.9 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="start_pole">
      <static>true</static>
      <pose>-1 0 1.5 0 0 0</pose>
      <link name="pole_link">
        <visual name="pole_visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.6 0.2 1</ambient>
            <diffuse>0.2 0.8 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============== MARKER GOAL (đỏ) ============== -->
    <model name="goal_marker">
      <static>true</static>
      <pose>100 0 0.01 0 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry>
            <box>
              <size>2 4 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.1 0.1 1</ambient>
            <diffuse>0.9 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="goal_pole">
      <static>true</static>
      <pose>101 0 1.5 0 0 0</pose>
      <link name="pole_link">
        <visual name="pole_visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.1 0.1 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============== VẬT CẢN ============== -->
    
    <!-- Obstacle 01: Box giữa đường (chắc chắn gặp) -->
    <model name="obstacle_01">
      <static>true</static>
      <pose>15 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.2 1.2 1.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.2 1.2 1.2</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.4 0.1 1</ambient>
            <diffuse>0.9 0.5 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 02: Cylinder bên phải -->
    <model name="obstacle_02">
      <static>true</static>
      <pose>25 1.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.7</radius><length>1.2</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.7</radius><length>1.2</length></cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.2 0.6 1</ambient>
            <diffuse>0.7 0.3 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 03: Box bên trái -->
    <model name="obstacle_03">
      <static>true</static>
      <pose>35 -1.2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.4 1.4 1.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.4 1.4 1.2</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.7 1</ambient>
            <diffuse>0.3 0.6 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 04: Cylinder hơi phải -->
    <model name="obstacle_04">
      <static>true</static>
      <pose>45 0.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.6</radius><length>1.2</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.6</radius><length>1.2</length></cylinder>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.2 1</ambient>
            <diffuse>0.8 0.8 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 05: Box hơi trái -->
    <model name="obstacle_05">
      <static>true</static>
      <pose>55 -0.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.3 1.3 1.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.3 1.3 1.2</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.7 0.5 1</ambient>
            <diffuse>0.4 0.8 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 06: Cylinder bên phải xa -->
    <model name="obstacle_06">
      <static>true</static>
      <pose>65 1.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.8</radius><length>1.2</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.8</radius><length>1.2</length></cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.3 0.3 1</ambient>
            <diffuse>0.9 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 07: Box bên trái xa -->
    <model name="obstacle_07">
      <static>true</static>
      <pose>75 -1.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.2 1.2 1.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.2 1.2 1.2</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.7 1</ambient>
            <diffuse>0.6 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 08: Cylinder gần giữa -->
    <model name="obstacle_08">
      <static>true</static>
      <pose>85 0.3 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.65</radius><length>1.2</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.65</radius><length>1.2</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.4 1</ambient>
            <diffuse>0.3 0.7 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 09: Box hơi trái -->
    <model name="obstacle_09">
      <static>true</static>
      <pose>92 -1.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.4 1.4 1.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.4 1.4 1.2</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.5 0.2 1</ambient>
            <diffuse>0.8 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 10: Cylinder gần GOAL -->
    <model name="obstacle_10">
      <static>true</static>
      <pose>98 1.2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.7</radius><length>1.2</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.7</radius><length>1.2</length></cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.6 1</ambient>
            <diffuse>0.5 0.5 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
  </world>
</sdf>
