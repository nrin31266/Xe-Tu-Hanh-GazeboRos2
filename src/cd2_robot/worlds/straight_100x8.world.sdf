<?xml version="1.0" ?>
<!--
  WORLD: Đường thẳng 3 làn (100m x 8m)
  - Làn 1: y = +2.0m (trái)
  - Làn 2: y = 0.0m  (giữa - xe spawn ở đây)
  - Làn 3: y = -2.0m (phải)
  - Mỗi làn rộng ~2m, có vạch kẻ đường rõ ràng
  
  VẬT CẢN: Đặt trên làn 2 (y≈0) để xe phải né
-->
<sdf version="1.8">
  <world name="straight_road_world">
    
    <!-- ============== PLUGINS HỆ THỐNG ============== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    
    <!-- ============== VẬT LÝ ============== -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    
    <!-- ============== ÁNH SÁNG ============== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>
    
    <light type="directional" name="sun2">
      <cast_shadows>false</cast_shadows>
      <pose>50 0 30 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 -0.5 -1</direction>
    </light>
    
    <!-- ============== MẶT ĐẤT NỀN ============== -->
    <model name="ground_plane">
      <static>true</static>
      <pose>50 0 -0.05 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>120 15 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box>
              <size>120 15 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.2 1</ambient>
            <diffuse>0.3 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============== MẶT ĐƯỜNG CHÍNH (3 làn x 2m = 6m) ============== -->
    <model name="road_surface">
      <static>true</static>
      <pose>50 0 0.001 0 0 0</pose>
      <link name="road_link">
        <visual name="road_visual">
          <geometry>
            <box>
              <size>105 6.5 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.3 0.3 0.33 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============== VẠCH KẺ ĐƯỜNG ============== -->
    
    <!-- Vạch trắng bên trái đường (y = +3.25m) -->
    <model name="line_left_edge">
      <static>true</static>
      <pose>50 3.25 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>105 0.15 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Vạch trắng bên phải đường (y = -3.25m) -->
    <model name="line_right_edge">
      <static>true</static>
      <pose>50 -3.25 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>105 0.15 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Vạch vàng phân làn 1-2 (y = +1.1m) - liền nét -->
    <model name="line_lane_12">
      <static>true</static>
      <pose>50 1.1 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>105 0.12 0.002</size></box></geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>1.0 0.9 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Vạch vàng phân làn 2-3 (y = -1.1m) - liền nét -->
    <model name="line_lane_23">
      <static>true</static>
      <pose>50 -1.1 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>105 0.12 0.002</size></box></geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>1.0 0.9 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============== MARKER START (xanh lá neon) ============== -->
    <!-- Vạch kẻ ô caro START -->
    <model name="start_checker_1">
      <static>true</static>
      <pose>-0.5 2.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_checker_2">
      <static>true</static>
      <pose>0.5 2.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.2 1 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_checker_3">
      <static>true</static>
      <pose>-0.5 1.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.2 1 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_checker_4">
      <static>true</static>
      <pose>0.5 1.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_checker_5">
      <static>true</static>
      <pose>-0.5 0.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_checker_6">
      <static>true</static>
      <pose>0.5 0.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.2 1 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_checker_7">
      <static>true</static>
      <pose>-0.5 -0.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.2 1 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_checker_8">
      <static>true</static>
      <pose>0.5 -0.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_checker_9">
      <static>true</static>
      <pose>-0.5 -1.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_checker_10">
      <static>true</static>
      <pose>0.5 -1.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.2 1 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_checker_11">
      <static>true</static>
      <pose>-0.5 -2.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.2 1 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_checker_12">
      <static>true</static>
      <pose>0.5 -2.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <!-- Cổng START (2 cột + thanh ngang) -->
    <model name="start_pole_left">
      <static>true</static>
      <pose>0 3.5 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.2 1 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_pole_right">
      <static>true</static>
      <pose>0 -3.5 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.2 1 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="start_arch">
      <static>true</static>
      <pose>0 0 2.8 1.5708 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>7</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.2 1 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    
    <!-- ============== MARKER GOAL (đỏ/cam neon) ============== -->
    <!-- Vạch kẻ ô caro FINISH -->
    <model name="goal_checker_1">
      <static>true</static>
      <pose>99.5 2.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="goal_checker_2">
      <static>true</static>
      <pose>100.5 2.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 0.3 0.1 1</ambient><diffuse>1 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="goal_checker_3">
      <static>true</static>
      <pose>99.5 1.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 0.3 0.1 1</ambient><diffuse>1 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="goal_checker_4">
      <static>true</static>
      <pose>100.5 1.5 0.004 0 0 0</pose>
      <link name="link">
