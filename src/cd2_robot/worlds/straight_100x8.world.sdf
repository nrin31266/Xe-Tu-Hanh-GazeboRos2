    <!-- ============== VẬT CẢN RẢI RÁC TRÊN 3 LÀN ============== -->
    <!-- Làn 1: y ≈ +2.0 | Làn 2: y ≈ 0.0 | Làn 3: y ≈ -2.0 -->
    <!-- MÀU SẮC: Hồng, Tím, Xanh dương, Xanh lá, Cam, Vàng -->
    
    <!-- Vật cản 1: Làn 2 (giữa) - x=12 - HỘP HỒNG NEON -->
    <model name="obstacle_01">
      <static>true</static>
      <pose>12 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.8 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.8 1.2</size></box></geometry>
          <material><ambient>1 0.2 0.6 1</ambient><diffuse>1 0.3 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <!-- Vật cản 2: Làn 1 (trái) - x=20 - TRỤ XANH DƯƠNG -->
    <model name="obstacle_02">
      <static>true</static>
      <pose>20 2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.85</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.85</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.2 0.6 1 1</ambient><diffuse>0.3 0.7 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <!-- Vật cản 3: Làn 2 (giữa) - x=28 - HỘP TÍM -->
    <model name="obstacle_03">
      <static>true</static>
      <pose>28 0.1 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.8 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.8 1.2</size></box></geometry>
          <material><ambient>0.7 0.2 0.9 1</ambient><diffuse>0.8 0.3 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <!-- Vật cản 4: Làn 3 (phải) - x=35 - TRỤ CAM -->
    <model name="obstacle_04">
      <static>true</static>
      <pose>35 -2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.85</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.85</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>1 0.5 0.1 1</ambient><diffuse>1 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <!-- Vật cản 5: Làn 1 (trái) - x=42 - HỘP VÀNG NEON -->
    <model name="obstacle_05">
      <static>true</static>
      <pose>42 2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.8 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.8 1.2</size></box></geometry>
          <material><ambient>1 0.9 0.1 1</ambient><diffuse>1 1 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <!-- Vật cản 6: Làn 2 (giữa) - x=48 - TRỤ XANH LÁ -->
    <model name="obstacle_06">
      <static>true</static>
      <pose>48 -0.1 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.85</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.85</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.2 0.9 0.3 1</ambient><diffuse>0.3 1 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <!-- Vật cản 7: Làn 3 (phải) - x=55 - HỘP HỒNG -->
    <model name="obstacle_07">
      <static>true</static>
      <pose>55 -2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.8 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.8 1.2</size></box></geometry>
          <material><ambient>1 0.4 0.7 1</ambient><diffuse>1 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <!-- Vật cản 8: Làn 2 (giữa) - x=62 - TRỤ XANH DƯƠNG SÁNG -->
    <model name="obstacle_08">
      <static>true</static>
