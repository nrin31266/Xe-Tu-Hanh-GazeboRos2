          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <!-- Cổng FINISH (2 cột + thanh ngang) -->
    <model name="goal_pole_left">
      <static>true</static>
      <pose>100 3.5 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry>
          <material><ambient>1 0.3 0.1 1</ambient><diffuse>1 0.4 0.2 1</diffuse></material>
        </visual>
