          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="goal_checker_5">
      <static>true</static>
      <pose>99.5 0.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="goal_checker_6">
      <static>true</static>
      <pose>100.5 0.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 0.3 0.1 1</ambient><diffuse>1 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="goal_checker_7">
      <static>true</static>
      <pose>99.5 -0.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 0.3 0.1 1</ambient><diffuse>1 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="goal_checker_8">
      <static>true</static>
      <pose>100.5 -0.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="goal_checker_9">
      <static>true</static>
      <pose>99.5 -1.5 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
